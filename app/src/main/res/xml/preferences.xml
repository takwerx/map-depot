<?xml version="1.0" encoding="utf-8"?>
<!--
    Map Depot has almost no settings: the depot address is fixed, and
    everything else is a choice made on the page itself. This screen exists so
    the manual has somewhere to be reached from (ATAK surfaces a plugin's
    documentation through its Tool Preferences entry, and without one the PDF
    ships inside the APK with no way for anyone to open it) and, since CARTO
    began requiring one, to hold the operator's own basemap API key.

    The key preference is wired by hand in MapDepotPreferenceFragment rather
    than bound to this key, so that it lives in the MapView context's
    preferences with everything else and survives a plugin reload.
-->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <com.atakmap.android.gui.PanPreference
        android:key="manual"
        android:title="@string/manual_title"
        android:summary="@string/manual_summary" />

    <PreferenceCategory android:title="@string/keys_heading">

        <EditTextPreference
            android:key="key_carto"
            android:title="@string/key_carto_title"
            android:dialogTitle="@string/key_carto_title"
            android:dialogMessage="@string/key_carto_dialog"
            android:inputType="textVisiblePassword|textNoSuggestions"
            android:singleLine="true"
            android:persistent="false" />

    </PreferenceCategory>

</PreferenceScreen>
