<?xml version="1.0" encoding="utf-8"?>
<!-- blocksDescendants so the row itself is clickable. A focusable Button inside
     a list item takes the touch and the list's own item click never fires, which
     is why tapping a row to go to it did nothing. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:descendantFocusability="blocksDescendants"
    android:orientation="horizontal"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- breakStrategy simple so a long name breaks at its hyphens rather
             than mid-word: FIELDER-MTN-OVERLA / Y-UAS-IR was what the balanced
             strategy produced once two buttons had taken the width. -->
        <TextView
            android:id="@+id/region_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:breakStrategy="simple"
            android:hyphenationFrequency="none"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/region_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp" />

        <!-- Only visible while this region is downloading, so a row is one line
             of text at rest and does not make the list jump. -->
        <ProgressBar
            android:id="@+id/region_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Shown only for an installed incident map, where turning the overlay on
         and off is otherwise a trip out to ATAK's overlay manager and back. Not
         an icon: the plugin has no eye asset of its own and cannot reach ATAK's,
         and a word says which state it is in rather than which state it will
         go to, which an eye alone never settles. -->
    <Button
        style="@style/TakwerxButton"
        android:id="@+id/region_visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:layout_gravity="center_vertical"
        android:layout_marginEnd="4dp"
        android:minWidth="60dp"
        android:visibility="gone" />

    <Button
        style="@style/TakwerxButton"
        android:id="@+id/region_action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:layout_gravity="center_vertical"
        android:minWidth="84dp"
        android:text="@string/download" />

</LinearLayout>
