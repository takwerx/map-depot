<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Landing: pick what kind of data you are after. Two kinds today; the
         layout is a list of choices so a third does not need a redesign. -->
    <LinearLayout
        android:id="@+id/home_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <Button
            android:id="@+id/btn_dted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:minHeight="72dp"
            android:text="@string/elevation_heading" />

        <Button
            android:id="@+id/btn_maps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="72dp"
            android:text="@string/maps_heading" />

        <TextView
            android:id="@+id/home_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="10dp"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Elevation: country first, then its regions. -->
    <LinearLayout
        android:id="@+id/dted_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/back" />

            <!-- Not a Spinner. A Spinner opens its list as a window built from
                 the context it was inflated with, which for a plugin is the
                 plugin context: no window token, BadTokenException, ATAK dies.
                 A button plus a chooser dialog on ATAK's own context behaves
                 the same for the operator and cannot do that. -->
            <Button
                android:id="@+id/country_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1" />
        </LinearLayout>

        <TextView
            android:id="@+id/depot_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="4dp"
            android:paddingTop="4dp"
            android:text="@string/loading_catalog"
            android:textSize="13sp" />

        <ListView
            android:id="@+id/region_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="#33FFFFFF"
            android:dividerHeight="1dp" />
    </LinearLayout>

</LinearLayout>
