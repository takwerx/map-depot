<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Landing: pick what kind of data you are after. Four kinds today, and
         the list scrolls, because it already did not fit: on an XCover Pro the
         fourth button was cut in half with nothing to scroll, and on ATAK 5.7
         it was clipped further still. A fixed column of choices silently loses
         the last one on a short pane, and would lose two when a fifth is
         added. fillViewport keeps it looking the same when there is room. -->
    <ScrollView
        android:id="@+id/home_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <Button
            style="@style/TakwerxButton"
            android:id="@+id/btn_dted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="3dp"
            android:minHeight="46dp"
            android:text="@string/elevation_heading" />

        <Button
            style="@style/TakwerxButton"
            android:id="@+id/btn_maps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="3dp"
            android:minHeight="46dp"
            android:text="@string/maps_heading" />

        <Button
            style="@style/TakwerxButton"
            android:id="@+id/btn_forests"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="3dp"
            android:minHeight="46dp"
            android:text="@string/forests_heading" />

        <Button
            style="@style/TakwerxButton"
            android:id="@+id/btn_recmaps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="3dp"
            android:minHeight="46dp"
            android:text="@string/recmaps_heading" />

        <Button
            style="@style/TakwerxButton"
            android:id="@+id/btn_nifc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="3dp"
            android:minHeight="46dp"
            android:text="@string/nifc_heading" />

        <Button
            style="@style/TakwerxButton"
            android:id="@+id/btn_uaswfc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="46dp"
            android:text="@string/uaswfc_heading" />

        <TextView
            android:id="@+id/home_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="10dp"
            android:textSize="12sp" />
    </LinearLayout>
    </ScrollView>

    <!-- Public lands: 148 units is far too many for a chooser dialog, so this
         one filters as you type. Search rather than a picker also matches how
         someone actually arrives here, knowing the name of their forest. -->
    <LinearLayout
        android:id="@+id/forest_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                style="@style/TakwerxButton"
                android:id="@+id/btn_back_forests"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/back" />

            <!-- Which Forest Service series the list shows. A chooser, not a
                 Spinner: a Spinner's dropdown is a Dialog on the plugin
                 context and takes ATAK down. Hidden on the public-lands list,
                 which has one series. -->
            <Button
                style="@style/TakwerxButton"
                android:id="@+id/sheet_series"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:minWidth="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:visibility="gone" />

            <!-- flagNoExtractUi on the imeOptions below: without it Android
                 takes the whole screen with its own text box the moment you tap
                 here, because ATAK runs landscape. Typing happens on the line. -->
            <Button
                style="@style/TakwerxButton"
                android:id="@+id/package_filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:minWidth="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp" />

            <EditText
                android:id="@+id/forest_search"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:hint="@string/search_forests"
                android:imeOptions="actionSearch|flagNoExtractUi"
                android:inputType="text"
                android:maxLines="1"
                android:singleLine="true" />
        </LinearLayout>

        <!-- Cancel lives here, not in the row. A row button moves when the list
             scrolls or reflows, changes label mid-download, and is the size of a
             thumbnail; this is always in the same place and full width. -->
        <Button
            style="@style/TakwerxButton"
            android:id="@+id/cancel_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:minHeight="56dp"
            android:text="@string/cancel_download"
            android:visibility="gone" />

        <!-- Same pinned outlines control the incident list has. District maps
             are GeoPDFs and draw the same footprints. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                style="@style/TakwerxButton"
                android:id="@+id/forest_outlines"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp" />

            <TextView
                android:id="@+id/forest_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:minLines="2"
                android:maxLines="3"
                android:ellipsize="end"
                android:paddingBottom="4dp"
                android:paddingTop="4dp"
                android:textSize="13sp" />
        </LinearLayout>

        <ListView
            android:id="@+id/forest_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- Base maps: category first, then the sources in it. -->
    <LinearLayout
        android:id="@+id/basemap_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                style="@style/TakwerxButton"
                android:id="@+id/btn_back_maps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/back" />

            <Button
                style="@style/TakwerxButton"
                android:id="@+id/basemap_filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:minWidth="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp" />

            <Button
                style="@style/TakwerxButton"
                android:id="@+id/category_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1" />
        </LinearLayout>

        <TextView
            android:id="@+id/basemap_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="2"
            android:maxLines="2"
            android:ellipsize="end"
            android:paddingBottom="4dp"
            android:paddingTop="4dp"
            android:textSize="13sp" />

        <ListView
            android:id="@+id/basemap_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="#33FFFFFF"
            android:dividerHeight="1dp" />
    </LinearLayout>

    <!-- Elevation: country first, then its regions. -->
    <LinearLayout
        android:id="@+id/dted_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                style="@style/TakwerxButton"
                android:id="@+id/btn_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/back" />

            <!-- Not a Spinner. A Spinner opens its list as a window built from
                 the context it was inflated with, which for a plugin is the
                 plugin context: no window token, BadTokenException, ATAK dies.
                 A button plus a chooser dialog on ATAK's own context behaves
                 the same for the operator and cannot do that. -->
            <Button
                style="@style/TakwerxButton"
                android:id="@+id/region_filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:minWidth="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp" />

            <Button
                style="@style/TakwerxButton"
                android:id="@+id/country_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1" />
        </LinearLayout>

        <Button
            style="@style/TakwerxButton"
            android:id="@+id/cancel_bar_dted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:minHeight="56dp"
            android:text="@string/cancel_download"
            android:visibility="gone" />

        <TextView
            android:id="@+id/depot_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="2"
            android:maxLines="2"
            android:ellipsize="end"
            android:paddingBottom="4dp"
            android:paddingTop="4dp"
            android:text="@string/loading_catalog"
            android:textSize="13sp" />

        <ListView
            android:id="@+id/region_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="#33FFFFFF"
            android:dividerHeight="1dp" />
    </LinearLayout>


    <!-- NIFC incident maps.
         One list, not a fixed set of screens, because the eleven GACCs do not
         agree on a layout: most are <gacc>/2026/2026_Fire/, Oregon nests its
         fires under 2026_Incidents_Oregon/, southern mixes state folders in,
         and california_statewide has no year folder at all. A wizard modelled
         on any one of them is wrong for the others, so this walks the tree it
         actually finds and shows a breadcrumb of where it is. -->
    <LinearLayout
        android:id="@+id/nifc_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                style="@style/TakwerxButton"
                android:id="@+id/btn_back_nifc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/back" />

            <!-- States what it will cost before it is used: "Installed (3)",
                 not "Installed". Otherwise the only way to learn what the
                 control does is to press it and watch the list move. -->
            <Button
                style="@style/TakwerxButton"
                android:id="@+id/nifc_filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/filter_all" />

            <!-- The GACC is remembered, so this reads as the operator's own
                 region rather than as a filter they have to set every time. -->
            <Button
                style="@style/TakwerxButton"
                android:id="@+id/nifc_gacc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- Pinned above the list rather than in it, so it stays put while the
             list scrolls. Outlines are a property of every GRG at once, not of
             a row, which is why it does not live on one. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                style="@style/TakwerxButton"
                android:id="@+id/nifc_outlines"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp" />

            <TextView
                android:id="@+id/nifc_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            style="@style/TakwerxButton"
            android:id="@+id/cancel_bar_nifc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:minHeight="56dp"
            android:text="@string/cancel_download"
            android:visibility="gone" />

        <ListView
            android:id="@+id/nifc_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1" />
    </LinearLayout>

</LinearLayout>
